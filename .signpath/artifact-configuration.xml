<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into the SignPath project's artifact configuration.
     The GitHub artifact is a zip of bin\; only our own executable needs signing
     (the WebView2 DLLs are already signed by Microsoft). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="BetterGlorious.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
